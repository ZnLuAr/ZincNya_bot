        {"id": 2300001, "scope_type": "global", "scope_id": "global", "content": "2025年3月，音乐制作人林澈在Ableton Live中把人声录音的采样率设为48 kHz；只有为短片项目交付同期声时适用。", "enabled": true, "mode": "contextual", "tags": ["音乐制作", "录音"], "priority": 2, "source": "inferred"},
        {"id": 2300002, "scope_type": "global", "scope_id": "global", "content": "2025年3月，林澈为短片项目的人声轨使用了-12 dBFS的录音峰值目标；只有在48 kHz同期声录制流程中适用。", "enabled": true, "mode": "contextual", "tags": ["音乐制作", "增益"], "priority": 2, "source": "inferred"},
        {"id": 2300003, "scope_type": "global", "scope_id": "global", "content": "2025年4月，音乐制作人周遥把鼓组总线上压缩器的比率设为4:1；只有为电子摇滚单曲《潮汐灯》做混音时适用。", "enabled": true, "mode": "contextual", "tags": ["音乐制作", "混音"], "priority": 1, "source": "inferred"},
        {"id": 2300004, "scope_type": "global", "scope_id": "global", "content": "2025年4月，周遥把《潮汐灯》的鼓组总线压缩器攻击时间设为30毫秒；只有该单曲进入混音阶段时适用。", "enabled": true, "mode": "contextual", "tags": ["音乐制作", "鼓组"], "priority": 1, "source": "inferred"},
        {"id": 2300005, "scope_type": "global", "scope_id": "global", "content": "2025年5月，音乐制作人许棠把播客片头的旁白高通滤波器截止频率设为80 Hz；只有处理人声旁白时适用。", "enabled": true, "mode": "contextual", "tags": ["音乐制作", "播客"], "priority": 1, "source": "inferred"},
        {"id": 2300006, "scope_type": "global", "scope_id": "global", "content": "2025年5月，许棠把播客片头旁白的去齿音频段中心设在6.5 kHz；只有旁白齿音明显的版本中适用。", "enabled": true, "mode": "contextual", "tags": ["音乐制作", "人声"], "priority": 1, "source": "inferred"},
        {"id": 2300007, "scope_type": "global", "scope_id": "global", "content": "2025年6月，音乐制作人顾言把合成器铺底声的立体声宽度控制在110%；只有为游戏预告片制作氛围层时适用。", "enabled": true, "mode": "contextual", "tags": ["音乐制作", "合成器"], "priority": 1, "source": "inferred"},
        {"id": 2300008, "scope_type": "global", "scope_id": "global", "content": "2025年6月，顾言把游戏预告片的合成器铺底声自动化在副歌前两小节降低3 dB；只有预告片最终混音版本中适用。", "enabled": true, "mode": "contextual", "tags": ["音乐制作", "自动化"], "priority": 1, "source": "inferred"}
      ],
      "cases": [
        {"caseID": "leisure-music-multi-01", "query": {"currentText": "林澈给短片同期声录人声时，采样率和峰值目标分别是多少？"}, "requiredIDs": [2300001, 2300002], "allowedIDs": [], "forbiddenIDs": [2300003, 2300004, 2300005, 2300006, 2300007, 2300008], "allowAbstain": false, "metadata": {"reviewStatus": "draft", "annotationRationale": "问题同时询问同一录音流程的采样率和峰值目标，两条事实都直接决定完整回答。"}},
